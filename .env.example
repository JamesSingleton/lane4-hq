# Neon Postgres and Object Storage
# `neon deploy` provisions the buckets; `neon env pull` fills these values.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Existing installation cutover (optional)
SOURCE_DATABASE_URL=
# IMAGE_IMPORT_ALLOWED_ORIGINS=http://127.0.0.1:54321

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=http://localhost:3004
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.com

# Email
RESEND_API_KEY=
EMAIL_FROM=Lane4 HQ <onboarding@resend.dev>

# Polar billing
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_ENTERPRISE=
POLAR_SERVER=sandbox

# Legacy Stripe billing helpers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Calendar OAuth and social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# PostHog product analytics. Leave every key empty to disable it.
# Browser (apps/web, apps/admin). Project token, not a personal key.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server (apps/web, apps/admin, apps/api). Same project token, kept off the client.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Optional Next.js source maps. Personal key (phx_), not the project token.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Desktop (apps/desktop, Vite). Same project token as the browser.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional integrations
OPENAI_API_KEY=
USA_SWIMMING_VENDOR_THUMBPRINT=
USA_SWIMMING_API_URL=

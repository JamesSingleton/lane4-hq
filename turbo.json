{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
      "env": [
        "BETTER_AUTH_*",
        "NEXT_PUBLIC_*",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_ENDPOINT_URL_S3",
        "AWS_REGION",
        "RESEND_*",
        "EMAIL_FROM",
        "POLAR_*",
        "STRIPE_*",
        "GOOGLE_*",
        "MICROSOFT_*",
        "OPENAI_API_KEY",
        "USA_SWIMMING_*",
        "API_ALLOWED_ORIGINS",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "DESKTOP_RELEASES_REPO",
        "GITHUB_RELEASE_TOKEN",
        "LANE4_*",
        "SKIP_ENV_VALIDATION"
      ]
    },
    "dev": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "persistent": true,
      "cache": false,
      "env": [
        "BETTER_AUTH_*",
        "NEXT_PUBLIC_*",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_ENDPOINT_URL_S3",
        "AWS_REGION",
        "RESEND_*",
        "EMAIL_FROM",
        "POLAR_*",
        "STRIPE_*",
        "GOOGLE_*",
        "MICROSOFT_*",
        "OPENAI_API_KEY",
        "USA_SWIMMING_*",
        "API_ALLOWED_ORIGINS",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "DESKTOP_RELEASES_REPO",
        "GITHUB_RELEASE_TOKEN",
        "LANE4_*",
        "SKIP_ENV_VALIDATION"
      ]
    },
    "check:types": {
      "dependsOn": ["^check:types"]
    },
    "format": {},
    "lint": {
      "dependsOn": ["^topo"]
    },
    "lint:fix": {
      "dependsOn": ["^topo"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^topo"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "env": [
        "SKIP_ENV_VALIDATION",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_ENDPOINT_URL_S3",
        "AWS_REGION",
        "BETTER_AUTH_*"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^topo"],
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_URL_UNPOOLED"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_URL_UNPOOLED"]
    },
    "db:studio": {
      "persistent": true,
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_URL_UNPOOLED"]
    },
    "email:dev": {
      "persistent": true,
      "cache": false
    }
  }
}
